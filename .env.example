# Copy this file to `.env` (git-ignored). Docker Compose and the backend both read it.

# "anthropic" calls the real API and needs a key; "mock" answers offline with no key.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Models. Haiku 5.5 is the default everywhere. Set ANSWER_MODEL=claude-opus-5-5 for
# higher answer quality at roughly 40x the price per question.
ANSWER_MODEL=claude-haiku-5-5
REWRITE_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-haiku-5-5

# Backend storage (uploads, SQLite, vector index). On Windows keep it outside OneDrive, e.g.
# DATA_DIR=C:\Users\you\AppData\Local\pdf-chat-rag\data
#DATA_DIR=

# Comma-separated browser origins allowed to call the API (the Vite dev server is always allowed).
#CORS_ORIGINS=http://localhost:5173
